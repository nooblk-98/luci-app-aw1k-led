#!/bin/sh /etc/rc.common

START=99
STOP=10

USE_PROCD=1

start_service() {
    local enabled night_enabled
    config_load ledstatus
    config_get enabled settings enabled '1'
    config_get night_enabled settings night_enabled '0'

    [ "$enabled" = "0" ] && return 0

    if [ "$night_enabled" = "1" ]; then
        /usr/bin/led-night-mode.sh start-scheduler >/dev/null 2>&1
        /usr/bin/led-night-mode.sh check >/dev/null 2>&1
    else
        /usr/bin/led-night-mode.sh stop-scheduler >/dev/null 2>&1
        /usr/bin/led-night-mode.sh off >/dev/null 2>&1 &
    fi

    procd_open_instance
    procd_set_param command /usr/bin/led-status-check-daemon.sh
    procd_set_param respawn
    procd_close_instance
}

stop_service() {
    /usr/bin/led-night-mode.sh stop-scheduler >/dev/null 2>&1
}

service_triggers() {
    procd_add_reload_trigger "ledstatus"
}
